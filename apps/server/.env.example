# 이 파일을 같은 폴더에 .env로 복사하고 값을 채우세요. .env는 git에 올라가지 않습니다.

# MongoDB 접속 주소 (replica set이어야 실시간 반영이 동작)
# 예: mongodb://user:pass@host1:27017,host2:27017/?replicaSet=rs0&authSource=admin
MONGODB_URI=

# 서버가 열릴 주소/포트. 127.0.0.1 = 이 기기에서만 접속 가능
HOST=127.0.0.1
PORT=31501

# 인증 방식 (기본 none)
#   none    인증 없음 — 이 기기에서만(HOST가 127.0.0.1/::1/localhost일 때만 켜짐)
#   google  내장 Google 로그인 (준비 중)
#   proxy   Cloudflare Access 같은 앞단이 로그인 처리 (준비 중)
# AUTH_MODE=none

# (선택) 앱 메타데이터(PK/FK 선언, titleKey, 내 oid 목록) 파일 위치. 기본: ~/.mongolive/meta.json
# MongoDB에는 아무것도 저장하지 않습니다.
# META_FILE=
