# 이 파일을 같은 폴더에 .env로 복사하고 값을 채우세요. .env는 git에 올라가지 않습니다.

# MongoDB 접속 주소 (replica set이어야 실시간 반영이 동작)
# 예: mongodb://user:pass@host1:27017,host2:27017/?replicaSet=rs0&authSource=admin
MONGODB_URI=

# 서버가 열릴 주소/포트. 127.0.0.1 = 이 기기에서만 접속 가능
HOST=127.0.0.1
PORT=4000

# 인증 방식 (기본 password)
#   password  내장 비밀번호 로그인 — 이 기기에서 접속해도 로그인한다.
#             처음 한 번: corepack pnpm --filter @mongolive/server set-password
#   proxy     Tailscale, Cloudflare Access 같은 앞단이 로그인 처리 (준비 중)
# AUTH_MODE=password

# HTTPS 인증서 (선택). 둘 다 넣으면 HTTPS로 열린다. 파일이 바뀌면(갱신) 재시작 없이 새로 읽는다.
# HOST가 127.0.0.1이 아닌데(외부에 열림) HTTPS가 없으면 서버가 켜지지 않는다.
# TLS_CERT=/home/me/.mongolive/tls/cert.pem
# TLS_KEY=/home/me/.mongolive/tls/key.pem

# 외부에 HTTP로 열기(시험용, 비밀번호가 평문으로 오감). 기본 false
# ALLOW_INSECURE_HTTP=false

# 앞단 프록시(Caddy, nginx, Tailscale serve 등)가 HTTPS를 맡을 때 true. 기본 false
# 프록시가 붙여 주는 X-Forwarded-Proto/For/Host를 이 기기 안에서 온 연결일 때만 믿는다
# (쿠키 Secure, 로그인 잠금 IP, Origin 검사가 원래 요청 기준으로 동작). HOST는 127.0.0.1로 둔다.
# TRUST_PROXY=false

# (선택) 비밀번호 해시 + 쿠키 서명 키 파일 위치. 기본: ~/.mongolive/auth.json (권한 600)
# AUTH_FILE=

# (선택) 앱 메타데이터(PK/FK 선언, titleKey, 내 oid 목록) 파일 위치. 기본: ~/.mongolive/meta.json
# MongoDB에는 아무것도 저장하지 않습니다.
# META_FILE=
